rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMemberOfFirm(firmId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.firmId == firmId;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Rules for User Invites
    match /invites/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['ADMIN', 'EMPLOYEE'] &&
             data.firmId is string;
    }

    function isValidBuilding(data) {
      return data.keys().hasAll(['id', 'name', 'createdAt', 'ownerId', 'firmId']) &&
             data.id is string &&
             data.name is string && data.name.size() > 0 &&
             data.createdAt is string &&
             data.ownerId == request.auth.uid &&
             data.firmId is string;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'buildingId', 'type', 'title', 'amount', 'category', 'date', 'ownerId', 'firmId']) &&
             data.id is string &&
             data.buildingId is string &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.title is string && data.title.size() > 0 &&
             data.amount is number &&
             data.category is string &&
             data.date is string &&
             data.ownerId == request.auth.uid &&
             data.firmId is string;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['id', 'buildingId', 'name', 'type', 'initialBalance', 'ownerId', 'firmId']) &&
             data.id is string &&
             data.buildingId is string &&
             data.name is string && data.name.size() > 0 &&
             data.type in ['CASH', 'BANK', 'CREDIT', 'OTHER'] &&
             data.initialBalance is number &&
             data.ownerId == request.auth.uid &&
             data.firmId is string;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'ownerId', 'firmId']) &&
             data.id is string &&
             data.name is string && data.name.size() > 0 &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.ownerId == request.auth.uid &&
             data.firmId is string;
    }

    // Rules for User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && 
                    isValidUser(incoming()) &&
                    // Employees cannot change their own role or firmId
                    (isAdmin() || (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email'])));
      allow delete: if isAdmin();
    }

    // Connection test collection
    match /_connection_test_/{docId} {
      allow read: if true;
    }

    // Rules for Buildings
    match /buildings/{buildingId} {
      allow read: if isSignedIn() && (
        (resource != null && isMemberOfFirm(resource.data.firmId)) ||
        (resource == null && isAdmin())
      );
      allow create: if isSignedIn() && isValidBuilding(incoming());
      allow update: if isMemberOfFirm(existing().firmId) && isValidBuilding(incoming()) &&
                    incoming().firmId == existing().firmId;
      allow delete: if isMemberOfFirm(existing().firmId) && isAdmin();
    }

    // Rules for Transactions
    match /transactions/{txId} {
      allow read: if isMemberOfFirm(existing().firmId);
      allow create: if isSignedIn() && isValidTransaction(incoming()) && 
                    exists(/databases/$(database)/documents/buildings/$(incoming().buildingId)) &&
                    get(/databases/$(database)/documents/buildings/$(incoming().buildingId)).data.firmId == incoming().firmId;
      allow update: if isMemberOfFirm(existing().firmId) && isValidTransaction(incoming()) &&
                    incoming().firmId == existing().firmId;
      allow delete: if isMemberOfFirm(existing().firmId) && isAdmin();
    }

    // Rules for Accounts
    match /accounts/{accId} {
      allow read: if isMemberOfFirm(existing().firmId);
      allow create: if isSignedIn() && isValidAccount(incoming()) &&
                    exists(/databases/$(database)/documents/buildings/$(incoming().buildingId)) &&
                    get(/databases/$(database)/documents/buildings/$(incoming().buildingId)).data.firmId == incoming().firmId;
      allow update: if isMemberOfFirm(existing().firmId) && isValidAccount(incoming()) &&
                    incoming().firmId == existing().firmId;
      allow delete: if isMemberOfFirm(existing().firmId) && isAdmin();
    }

    // Rules for Categories
    match /categories/{catId} {
      allow read: if isMemberOfFirm(existing().firmId);
      allow create: if isSignedIn() && isValidCategory(incoming());
      allow update: if isMemberOfFirm(existing().firmId) && isValidCategory(incoming()) &&
                    incoming().firmId == existing().firmId;
      allow delete: if isMemberOfFirm(existing().firmId) && isAdmin();
    }
  }
}
